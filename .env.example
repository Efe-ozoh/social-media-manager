# CodeSync Hub environment variables (SPEC section 13).
# Copy to .env.local and fill in. Never commit real secrets.

# --- Phase 1 (required now) ---
DATABASE_URL=            # postgresql://user:password@host/db?sslmode=require
AUTH_SECRET=             # 32+ random chars; signs the session cookie
ALLOWED_LOGIN=           # scrypt$salt$hash from `npm run hash-password -- "pw"`
APP_URL=                 # e.g. http://localhost:3000

# --- Phase 2: slide image storage (optional) ---
# Vercel Blob read-write token for a PUBLIC store. When it is unset, slide
# images are written to public/uploads (git-ignored) and served from APP_URL,
# which is the development fallback.
BLOB_READ_WRITE_TOKEN=    # vercel_blob_rw_... from Vercel Blob

# --- Phase 2b: Unsplash background photos (optional) ---
# Create an app at https://unsplash.com/oauth/applications and copy its
# Access Key. Without it, backgrounds stay solid; search returns an error and
# the app keeps working.
UNSPLASH_ACCESS_KEY=      # Unsplash API access key (Demo apps: 50 req/hour)

# --- Phase 3: publishers (LinkedIn) ---
# Encrypts platform tokens at rest (AES-256-GCM), so it must be 32 bytes of
# base64. Generate one with: openssl rand -base64 32
# Changing it makes every stored token undecryptable: reconnect the accounts.
TOKEN_ENCRYPTION_KEY=

# Create an app at https://www.linkedin.com/developers/apps and add these two
# products: "Share on LinkedIn" (w_member_social) and "Sign In with LinkedIn
# using OpenID Connect" (openid, profile). Under Auth, add the redirect URL
# <APP_URL>/api/auth/linkedin/callback — it must match exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Phase 3: Meta app (Facebook Page + Instagram) — OFF by default ---
# Meta automated posting is switched off (the owner's Facebook account is
# blocked), so Instagram and Facebook are manual-export platforms now: the
# dashboard gives you the images and caption to post yourself.
#
# ENABLE_META=false makes both Meta OAuth routes answer reason=disabled and
# keeps Facebook/Instagram out of every connect and schedule list
# (lib/platforms.ts). The Meta code and its tests stay in place behind the
# switch. Only fill in the two credentials (and register the redirect URL
# below) if you turn it back on:
#   Facebook Login → Settings → Valid OAuth Redirect URIs:
#   <APP_URL>/api/auth/meta/callback — it must match exactly.
#   Scopes: pages_show_list, pages_read_engagement, pages_manage_posts,
#   instagram_basic, instagram_content_publish.
ENABLE_META=false
META_APP_ID=
META_APP_SECRET=         # App settings → Basic → App secret

# --- Phase 3: Telegram (automated publishing, no OAuth) ---
# Create a bot with @BotFather (/newbot) and copy its token, then add the bot
# to the target channel as an administrator with "Post messages" (or to a
# group). TELEGRAM_CHANNEL_ID is the numeric channel id (-100...) or
# @channelusername. The token is a secret: .env.local only, never committed.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# --- Phase 4: scheduler ---
# Shared secret for POST /api/cron/dispatch. Send it as the `x-cron-secret`
# header (or `Authorization: Bearer ...`). Generate one with:
#   openssl rand -hex 32
# Changing it means updating the external scheduler's header too.
CRON_SECRET=

# --- Later phases (not used yet) ---
LLM_PROVIDER=            # Phase 6
LLM_API_KEY=
LLM_MODEL=
