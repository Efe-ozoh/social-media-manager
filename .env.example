# CodeSync Hub environment variables (SPEC section 13).
# Copy to .env.local and fill in. Never commit real secrets.

# --- Phase 1 (required now) ---
DATABASE_URL=            # postgresql://user:password@host/db?sslmode=require
AUTH_SECRET=             # 32+ random chars; signs the session cookie
ALLOWED_LOGIN=           # scrypt$salt$hash from `npm run hash-password -- "pw"`
APP_URL=                 # e.g. http://localhost:3000

# --- Later phases (not used yet) ---
TOKEN_ENCRYPTION_KEY=    # AES-256-GCM key for platform tokens (Phase 3)
CRON_SECRET=             # shared secret for /api/cron/dispatch (Phase 4)
META_APP_ID=             # Facebook + Instagram (Phase 3)
META_APP_SECRET=
LINKEDIN_CLIENT_ID=      # LinkedIn (Phase 3)
LINKEDIN_CLIENT_SECRET=
BLOB_READ_WRITE_TOKEN=   # Vercel Blob, or Cloudinary credentials (Phase 2)
LLM_PROVIDER=            # Phase 6
LLM_API_KEY=
LLM_MODEL=
