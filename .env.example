# CodeSync Hub environment variables (SPEC section 13).
# Copy to .env.local and fill in. Never commit real secrets.

# --- Phase 1 (required now) ---
DATABASE_URL=            # postgresql://user:password@host/db?sslmode=require
AUTH_SECRET=             # 32+ random chars; signs the session cookie
ALLOWED_LOGIN=           # scrypt$salt$hash from `npm run hash-password -- "pw"`
APP_URL=                 # e.g. http://localhost:3000

# --- Phase 2: slide image storage (optional) ---
# Vercel Blob read-write token for a PUBLIC store. When it is unset, slide
# images are written to public/uploads (git-ignored) and served from APP_URL,
# which is the development fallback.
BLOB_READ_WRITE_TOKEN=    # vercel_blob_rw_... from Vercel Blob

# --- Phase 2b: Unsplash background photos (optional) ---
# Create an app at https://unsplash.com/oauth/applications and copy its
# Access Key. Without it, backgrounds stay solid; search returns an error and
# the app keeps working.
UNSPLASH_ACCESS_KEY=      # Unsplash API access key (Demo apps: 50 req/hour)

# --- Phase 3: publishers (LinkedIn) ---
# Encrypts platform tokens at rest (AES-256-GCM), so it must be 32 bytes of
# base64. Generate one with: openssl rand -base64 32
# Changing it makes every stored token undecryptable: reconnect the accounts.
TOKEN_ENCRYPTION_KEY=

# Create an app at https://www.linkedin.com/developers/apps and add these two
# products: "Share on LinkedIn" (w_member_social) and "Sign In with LinkedIn
# using OpenID Connect" (openid, profile). Under Auth, add the redirect URL
# <APP_URL>/api/auth/linkedin/callback — it must match exactly.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- Phase 3: Meta app (Facebook Page + Instagram) ---
# One Meta app covers both. Create it at https://developers.facebook.com/apps,
# add the products "Facebook Login" and "Instagram" (API setup with Facebook
# Login), then under Facebook Login → Settings add the redirect URL
# <APP_URL>/api/auth/meta/callback — it must match exactly.
# Scopes used: pages_show_list, pages_read_engagement, pages_manage_posts,
# instagram_basic, instagram_content_publish. In Development mode the app
# owner can publish to their own Page/IG account without App Review.
META_APP_ID=
META_APP_SECRET=         # App settings → Basic → App secret

# --- Later phases (not used yet) ---
CRON_SECRET=             # shared secret for /api/cron/dispatch (Phase 4)
LLM_PROVIDER=            # Phase 6
LLM_API_KEY=
LLM_MODEL=
