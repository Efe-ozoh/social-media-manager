// CodeSync Hub data model — SPEC section 5.
// Columns are snake_case in Postgres (via @map/@@map); all timestamps are UTC.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Platform {
  linkedin
  facebook
  instagram
  // Added in 0003: the manual_export platforms (facebook, instagram) stay in
  // the model even while ENABLE_META is off — see lib/platforms.ts.
  telegram

  @@map("platform")
}

enum ContentType {
  text
  code

  @@map("content_type")
}

enum CarouselMode {
  auto
  on
  off

  @@map("carousel_mode")
}

/// Background for a post's slides: the themed solid colour, or a photo
/// chosen through the Unsplash picker (Phase 2b).
enum BackgroundMode {
  solid
  unsplash

  @@map("background_mode")
}

enum PostSource {
  manual
  ai

  @@map("post_source")
}

enum PostStatus {
  draft
  scheduled
  processing
  published
  partial
  failed

  @@map("post_status")
}

enum TargetStatus {
  pending
  processing
  published
  failed

  @@map("target_status")
}

model SocialAccount {
  id              String    @id @default(uuid()) @db.Uuid
  platform        Platform
  externalId      String    @map("external_id")
  displayName     String    @map("display_name")
  accessTokenEnc  String    @map("access_token_enc") @db.Text
  refreshTokenEnc String?   @map("refresh_token_enc") @db.Text
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([platform, externalId])
  @@map("social_accounts")
}

model Post {
  id              String         @id @default(uuid()) @db.Uuid
  title           String?        @db.VarChar(200)
  bodyText        String         @map("body_text") @db.Text
  contentType     ContentType    @default(text) @map("content_type")
  code            String?        @db.Text
  language        String?        @db.VarChar(50)
  theme           String         @db.VarChar(50)
  caption         String         @db.Text
  // Phase 5c: the caption is the whole post. No slides are rendered or stored,
  // and the dispatcher publishes it with an empty image list.
  textOnly        Boolean        @default(false) @map("text_only")
  carouselMode    CarouselMode   @default(auto) @map("carousel_mode")
  // Background photo (Phase 2b). backgroundMode "solid" ignores the bg_* row.
  backgroundMode  BackgroundMode @default(solid) @map("background_mode")
  backgroundQuery String?        @map("background_query") @db.VarChar(120)
  bgUnsplashId    String?        @map("bg_unsplash_id") @db.VarChar(64)
  bgUrl           String?        @map("bg_url") @db.Text
  bgThumbUrl      String?        @map("bg_thumb_url") @db.Text
  bgAuthorName    String?        @map("bg_author_name") @db.VarChar(120)
  bgAuthorUrl     String?        @map("bg_author_url") @db.Text
  bgColor         String?        @map("bg_color") @db.VarChar(16)
  // Phase 5c: the picker stores the photo's download endpoint so Unsplash can
  // be told about the use later, once, when the post is scheduled/published.
  bgDownloadLocation String?     @map("bg_download_location") @db.Text
  // The Unsplash id whose download has already been reported; a different id
  // means the photo changed after tracking and needs its own report.
  bgDownloadTracked  String?     @map("bg_download_tracked") @db.VarChar(64)
  // Off by default: code cards stay solid unless the owner opts in.
  usePhotoBehindCode Boolean     @default(false) @map("use_photo_behind_code")
  // On by default: automated posts append "Photo by {name} on Unsplash".
  bgCreditCaption    Boolean     @default(true) @map("bg_credit_caption")
  source          PostSource     @default(manual)
  aiPrompt        String?        @map("ai_prompt") @db.Text
  status          PostStatus     @default(draft)
  scheduledAt     DateTime?      @map("scheduled_at") @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  media   PostMedia[]
  targets PostTarget[]

  // Dispatch query: scheduled posts that are due.
  @@index([status, scheduledAt])
  @@map("posts")
}

/// One row per UTC day. The AI routes increment this atomically so
/// GEN_DAILY_CAP is shared across serverless instances.
model AiDailyBudget {
  day   String @id @db.VarChar(10)
  count Int    @default(0)

  @@map("ai_daily_budgets")
}

model PostMedia {
  id         String @id @default(uuid()) @db.Uuid
  postId     String @map("post_id") @db.Uuid
  slideIndex Int    @map("slide_index")
  url        String @db.Text
  width      Int
  height     Int

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, slideIndex])
  @@map("post_media")
}

model PostTarget {
  id                  String       @id @default(uuid()) @db.Uuid
  postId              String       @map("post_id") @db.Uuid
  platform            Platform
  captionOverride     String?      @map("caption_override") @db.Text
  status              TargetStatus @default(pending)
  attempts            Int          @default(0)
  lastError           String?      @map("last_error") @db.Text
  // Soft retry gate: a pending target is due once this is NULL or <= now.
  nextAttemptAt       DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  // Set when a dispatch claims the target, so a crashed run can be recovered.
  processingStartedAt DateTime?    @map("processing_started_at") @db.Timestamptz(3)
  // Publisher notes that are not fatal, e.g. a multi-image fallback.
  notes               String?      @db.Text
  // True when the owner must reconnect the account before another attempt.
  requiresReconnect   Boolean      @default(false) @map("requires_reconnect")
  externalPostId      String?      @map("external_post_id") @db.Text
  publishedAt         DateTime?    @map("published_at") @db.Timestamptz(3)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  // Dispatch query: due, not-yet-published targets.
  @@index([status, nextAttemptAt])
  @@index([status])
  @@index([postId])
  @@map("post_targets")
}
